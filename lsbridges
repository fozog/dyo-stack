#!/usr/bin/env bash

declare -A bridges
declare -A prefix


normalize_cidr() {
  local input="$1"
  python3 -c "
import ipaddress
val = '$input'
try:
    if '/' in val:
        ip, mask = val.split('/', 1)
        if mask.startswith('0x'):
            mask = str(ipaddress.IPv4Address(int(mask, 16)))
        val = f'{ip}/{mask}'
    net = ipaddress.ip_network(val, strict=False)
    print(net)
except Exception:
    print('$input')
"
}

update_bridge_tags() {
  local tag="$1"
  local bridge_list="$2"

  while IFS= read -r bridge; do
    [ -z "$bridge" ] && continue
    if [[ "${bridges[$bridge]}" == "OS" ]]; then
      bridges["$bridge"]="$tag"
    else
      echo "Error: Bridge '$bridge' was not found as an OS bridge or had an unexpected value ('${bridges[$bridge]}')." >&2
    fi
  done <<< "$bridge_list"
}

if command -v ip > /dev/null 2>&1; then
  OS_BRIDGES=$(ip -br link show type bridge 2>/dev/null | awk '{print $1}')
elif [[ "$(uname -s)" == "Darwin" ]] || command -v ifconfig > /dev/null 2>&1; then
  OS_BRIDGES=$(ifconfig 2>/dev/null | awk '
/^[^[:space:]]/ {
    iface = $1
    sub(/:.*/, "", iface)
}
/^[[:space:]]+member:/ {
    print iface
}
' | sort -u)
fi

while IFS= read -r bridge; do
  [ -n "$bridge" ] && bridges["$bridge"]="OS"
done <<< "$OS_BRIDGES"


if which docker > /dev/null 2>&1; then
    if sudo -n docker network ls > /dev/null 2>&1; then
	    DOCKER_BRIDGES=`sudo -n docker network ls --filter driver=bridge --format '{{.ID}}' | xargs -r sudo -n docker network inspect --format '{{if index .Options "com.docker.network.bridge.name"}}{{index .Options "com.docker.network.bridge.name"}}{{else if eq .Name "bridge"}}docker0{{else}}br-{{slice .Id 0 12}}{{end}}'`
    else
	echo "Lacks password-less sudo docker" >&2
    fi
fi
update_bridge_tags "Docker" "$DOCKER_BRIDGES"


if which virsh > /dev/null 2>&1; then
    if sudo -n virsh net-list > /dev/null 2>&1; then
        LIBVIRT_BRIDGES=$(sudo -n virsh net-list --name 2>/dev/null | while read -r net; do
            [ -n "$net" ] && sudo -n virsh net-dumpxml "$net" 2>/dev/null | grep -oP "<bridge name='\K[^']+"
        done)
    else
        echo "Lacks password-less sudo virsh" >&2
    fi
fi
update_bridge_tags "Libvirt" "$LIBVIRT_BRIDGES"

if which snap > /dev/null 2>&1 && snap list lxd > /dev/null 2>&1; then
    if sudo -n lxc network list > /dev/null 2>&1; then
        SNAP_BRIDGES=$(sudo -n lxc network list --format csv -c n,t 2>/dev/null | awk -F',' '$2=="bridge"{print $1}')
    else
        echo "Lacks password-less sudo lxc" >&2
    fi
fi
update_bridge_tags "Snap (LXD)" "$SNAP_BRIDGES"

if which container > /dev/null 2>&1; then
    APPLE_CONTAINER_BRIDGES=$(python3 -c "
import subprocess, json, ipaddress, sys

def get_bridge_ips(bridge_list):
    bridge_ips = {}
    for iface in bridge_list:
        try:
            out = subprocess.check_output(['ifconfig', iface], stderr=subprocess.DEVNULL).decode()
            for line in out.splitlines():
                if 'inet ' in line:
                    parts = line.split()
                    if len(parts) >= 2:
                        bridge_ips[iface] = parts[1]
        except Exception:
            pass
    return bridge_ips

def main():
    try:
        candidate_bridges = sys.argv[1:]
        out = subprocess.check_output(['container', 'network', 'list'], stderr=subprocess.DEVNULL).decode()
        nets = [line.split()[0] for line in out.splitlines()[1:] if line.strip()]
        if not nets:
            return
        inspect_data = json.loads(subprocess.check_output(['container', 'network', 'inspect'] + nets, stderr=subprocess.DEVNULL).decode())
        gateways = set()
        subnets = set()
        for n in inspect_data:
            gw = n.get('status', {}).get('ipv4Gateway')
            sn = n.get('status', {}).get('ipv4Subnet')
            if gw:
                gateways.add(gw)
            if sn:
                subnets.add(ipaddress.ip_network(sn, strict=False))
        
        bridge_ips = get_bridge_ips(candidate_bridges)
        matched = []
        for b, ip in bridge_ips.items():
            if ip in gateways:
                matched.append(b)
            else:
                try:
                    ip_obj = ipaddress.ip_address(ip)
                    if any(ip_obj in s for s in subnets):
                        matched.append(b)
                except Exception:
                    pass
        for b in matched:
            print(b)
    except Exception:
        pass

if __name__ == '__main__':
    main()
" "${!bridges[@]}" 2>/dev/null)
fi
update_bridge_tags "Apple Container" "$APPLE_CONTAINER_BRIDGES"



declare -A prefix

for bridge in "${!bridges[@]}"; do
  tag="${bridges[$bridge]}"
  raw_subnet=""

  case "$tag" in
    "Docker")
      if [ "$bridge" = "docker0" ]; then
        raw_subnet=$(sudo -n docker network inspect bridge --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null)
      else
        net_id=$(docker network ls --filter driver=bridge --format '{{.ID}}' 2>/dev/null | xargs -r sudo -n docker network inspect --format '{{if eq (index .Options "com.docker.network.bridge.name") "'"$bridge"'"}}{{.ID}}{{end}}' 2>/dev/null | grep -v '^$')
        [ -n "$net_id" ] && raw_subnet=$(sudo -n docker network inspect "$net_id" --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null)
      fi
      # Fallback to kernel interface IP if Docker inspect fails or lacks permissions
      if [ -z "$raw_subnet" ]; then
        if command -v ip > /dev/null 2>&1; then
          raw_subnet=$(ip -4 -o addr show dev "$bridge" 2>/dev/null | awk '{print $4}')
        elif command -v ifconfig > /dev/null 2>&1; then
          raw_subnet=$(ifconfig "$bridge" 2>/dev/null | awk '/inet / {print $2 "/" $4}')
        fi
      fi
      ;;
    "Libvirt")
      if which virsh > /dev/null 2>&1 && sudo -n virsh net-list > /dev/null 2>&1; then
        for net in $(sudo -n virsh net-list --name 2>/dev/null); do
          bname=$(sudo -n virsh net-dumpxml "$net" 2>/dev/null | grep -oP "<bridge name='\K[^']+")
          if [ "$bname" = "$bridge" ]; then
            ip_addr=$(sudo -n virsh net-dumpxml "$net" 2>/dev/null | grep -oP "<ip address='\K[^']+")
            netmask=$(sudo -n virsh net-dumpxml "$net" 2>/dev/null | grep -oP "netmask='\K[^']+")
            [ -n "$ip_addr" ] && raw_subnet="$ip_addr/24" # Adjust netmask conversion if needed
            break
          fi
        done
      fi
      ;;
    "Snap (LXD)")
      raw_subnet=$(sudo -n lxc network get "$bridge" ipv4.address 2>/dev/null)
      ;;
    "Apple Container")
      if which container > /dev/null 2>&1; then
        bridge_ip=$(ifconfig "$bridge" 2>/dev/null | awk '/inet / {print $2}')
        raw_subnet=$(python3 -c "
import subprocess, json, ipaddress, sys
target_ip = '$bridge_ip'
try:
    nets = [line.split()[0] for line in subprocess.check_output(['container', 'network', 'list'], stderr=subprocess.DEVNULL).decode().splitlines()[1:] if line.strip()]
    if nets:
        inspect_data = json.loads(subprocess.check_output(['container', 'network', 'inspect'] + nets, stderr=subprocess.DEVNULL).decode())
        for n in inspect_data:
            gw = n.get('status', {}).get('ipv4Gateway')
            sn = n.get('status', {}).get('ipv4Subnet')
            if target_ip and gw == target_ip:
                print(sn)
                sys.exit(0)
            if target_ip and sn:
                try:
                    if ipaddress.ip_address(target_ip) in ipaddress.ip_network(sn, strict=False):
                        print(sn)
                        sys.exit(0)
                except Exception:
                    pass
except Exception:
    pass
" 2>/dev/null)
      fi
      [ -z "$raw_subnet" ] && raw_subnet=$(ifconfig "$bridge" 2>/dev/null | awk '/inet / {print $2 "/" $4}')
      ;;
    *)
      if command -v ip > /dev/null 2>&1; then
        raw_subnet=$(ip -4 -o addr show dev "$bridge" 2>/dev/null | awk '{print $4}')
      elif command -v ifconfig > /dev/null 2>&1; then
        raw_subnet=$(ifconfig "$bridge" 2>/dev/null | awk '/inet / {print $2 "/" $4}')
      fi
      ;;
  esac

  if [ -n "$raw_subnet" ]; then
    prefix["$bridge"]=$(normalize_cidr "$raw_subnet")
  fi
done


for bridge in "${!bridges[@]}"; do
  echo "$bridge : ${bridges[$bridge]} : ${prefix[$bridge]}"
done
